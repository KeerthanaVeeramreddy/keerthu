{
	"name": "lnk_Parameters_AzureSql",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"parameters": {
			"domain name": {
				"type": "string"
			},
			"Database name": {
				"type": "string"
			},
			"Username": {
				"type": "string"
			},
			"Password": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "AzureSqlDatabase",
		"typeProperties": {
			"server": "@{linkedService().domain name}",
			"database": "@{linkedService().Database name}",
			"encrypt": "mandatory",
			"trustServerCertificate": true,
			"authenticationType": "SQL",
			"userName": "@{linkedService().Username}",
			"password": "@{linkedService().Password}"
		}
	}
}